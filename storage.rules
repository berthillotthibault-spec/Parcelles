rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function memberPath(workspaceId) {
      return /databases/(default)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid);
    }
    function isMember(workspaceId) {
      // n° 129 : même contrôle que firestore.rules (accessActive) : memberExpiresAt absent = accès illimité.
      return request.auth != null && firestore.exists(memberPath(workspaceId))
        && (firestore.get(memberPath(workspaceId)).data.get('memberExpiresAt', null) == null
          || firestore.get(memberPath(workspaceId)).data.memberExpiresAt > request.time.toMillis());
    }
    // Même périmètre que permissions.js (canMutate) : opérateur terrain photos et documents, comptabilité documents.
    function canWriteAttachment(workspaceId, entityType) {
      let role = firestore.get(memberPath(workspaceId)).data.role;
      return isMember(workspaceId) && (role in ['owner','manager','editor']
        || (role == 'operator' && entityType in ['photos','documents'])
        || (role == 'accountant' && entityType == 'documents'));
    }
    function isOwner(workspaceId) {
      return isMember(workspaceId) && firestore.get(memberPath(workspaceId)).data.role == 'owner';
    }

    // Pièces jointes déposées par sync.js (syncAttachments) : chemin attachments/{photos|documents}/{id},
    // métadonnées entityId/entityType cohérentes avec le chemin, 25 Mo au plus.
    // L'application ne supprime jamais une pièce jointe distante : la suppression est réservée au propriétaire.
    match /workspaces/{workspaceId}/attachments/{entityType}/{fileId} {
      // Conseiller / technicien (n° 129) : photos, et documents des catégories agronomiques seulement (même liste
      // que firestore.rules advisorReadable, lue sur la fiche data/documents__{id}).
      allow read: if isMember(workspaceId) && (firestore.get(memberPath(workspaceId)).data.role != 'advisor'
        || entityType == 'photos'
        || (entityType == 'documents'
          && firestore.get(/databases/(default)/documents/workspaces/$(workspaceId)/data/$('documents__' + fileId)).data.payload.category
            in ['Analyse de sol','Analyse','Plan / carte','Photo / constat','Réglementaire']));
      allow create, update: if canWriteAttachment(workspaceId, entityType)
        && entityType in ['photos','documents']
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.metadata != null
        && request.resource.metadata.entityId == fileId
        && request.resource.metadata.entityType == entityType;
      allow delete: if isOwner(workspaceId);
    }

    // n° 4 : instantanés cloud mensuels (backup-vault-ui.js) : propriétaire seul, en lecture (liste comprise),
    // dépôt et suppression ; nom produit par snapshotFileName (backup-vault.js), JSON de 50 Mo au plus,
    // jamais réécrit (un nouvel instantané a un nouveau nom). permissions.js : capacité 'cloud-snapshot'.
    match /workspaces/{workspaceId}/snapshots/{fileId} {
      allow read, delete: if isOwner(workspaceId);
      allow create: if isOwner(workspaceId)
        && fileId.matches('parcelles-instantane-[0-9]{8}T[0-9]{6}Z(-chiffre)?[.]json')
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType == 'application/json';
    }
  }
}
